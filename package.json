  "homepage": "https://github.com/narendragandhi/aem-junit-skill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narendragandhi/aem-junit-skill.git"
  },
  "bugs": {
    "url": "https://github.com/narendragandhi/aem-junit-skill/issues"
  }
}
