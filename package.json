{
  "name": "aem-junit-skill",
  "version": "1.1.1",
  "description": "AEM JUnit Testing skill for AI assistants - Comprehensive guide for testing Adobe Experience Manager with JUnit",
  "main": "index.js",
  "bin": {
    "aem-junit-skill": "./bin/run.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "skills/",
    "docs/",
    "examples/aem-test-verified/pom.xml",
    "examples/aem-test-verified/src/"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "test": "node bin/run.js examples",
    "test:cli": "node bin/run.js help && node bin/run.js deps && node bin/run.js template model",
    "test:prompts": "node scripts/validate-prompt-tests.js",
    "postinstall": "echo 'AEM JUnit Skill installed! Run: npx aem-junit-skill help'"
  },
  "keywords": [
    "aem",
    "adobe",
    "experience-manager",
    "junit",
    "testing",
    "mock",
    "wcm.io",
    "sling-models",
    "aem-cloud-service"
  ],
